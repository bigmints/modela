{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bigmints/modela/main/schemas/catalog.schema.json",
  "title": "Modela catalogue",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "catalogue_hash",
    "model_count",
    "models"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "catalogue_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "model_count": { "type": "integer", "minimum": 0 },
    "sources": { "type": "array" },
    "models": {
      "type": "array",
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "required": [
        "provider",
        "id",
        "name",
        "capabilities",
        "input_modalities",
        "output_modalities",
        "supported_parameters",
        "access",
        "classification",
        "source"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "input_modalities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "output_modalities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "context_length": { "type": ["integer", "null"], "minimum": 0 },
        "supported_parameters": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "access": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "enum": ["hosted_free", "paid", "unknown"]
            }
          }
        },
        "classification": {
          "type": "object",
          "required": ["basis", "confidence"]
        },
        "source": {
          "type": "object",
          "required": ["catalogue"]
        }
      }
    }
  }
}
